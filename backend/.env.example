# Postgres (Neon/Supabase free tier or local docker)
DATABASE_URL="postgresql://user:pass@localhost:5432/shuroku?schema=public"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Frontend origin for CORS (Next.js dev)
CORS_ORIGIN="http://localhost:3000"

PORT=4000
NODE_ENV=development
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Cookie SameSite policy. Use "lax" for local dev (same-site localhost).
# Use "none" when the frontend and API are on different domains in production
# (this also forces Secure, so both must be served over HTTPS).
COOKIE_SAMESITE=lax
